{
  "name": "deepseek-motion",
  "version": "0.1.0",
  "description": "Beautiful motion graphics from DeepSeek or any LLM. The model writes a tiny scene spec; curated presets handle the taste.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "deepseek-motion": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "matrix": "node scripts/matrix.ts",
    "prepare": "tsc"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "gsap": "^3.15.0",
    "hyperframes": "^0.8.124",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
